# ==============================================================================
# AEGIS // CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your environment-specific settings.
# WARNING: NEVER commit actual secret keys, passwords, or production tokens!
# ==============================================================================

# Target Web Server Default for Audits
AEGIS_DEFAULT_TARGET=http://127.0.0.1:8000
AEGIS_REQUEST_TIMEOUT=6

# Logging & Intrusion Detection Path
# Linux / macOS: /var/log/nginx/access.log
# Windows: C:/inetpub/logs/LogFiles/W3SVC1/u_ex.log
AEGIS_ACCESS_LOG_PATH=./access.log

# GeoIP & Threat Intelligence Telemetry
# Set to 'true' to enable passive online ASN & Geolocation enrichment for attacker IPs
AEGIS_ENABLE_GEO_LOOKUP=true
AEGIS_GEO_TIMEOUT=3

# Defense Firewalls
# Options: powershell, ufw, iptables, nginx, apache
AEGIS_DEFAULT_FIREWALL=powershell
